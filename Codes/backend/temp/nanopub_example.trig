@prefix np: <http://www.nanopub.org/nschema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix ex: <http://example.org/> .
@prefix cito: <http://purl.org/spar/cito/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix pav: <http://purl.org/pav/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .

ex:nanopub_1 a np:Nanopublication ;
    np:hasAssertion ex:nanopub_1_assertion ;
    np:hasProvenance ex:nanopub_1_provenance ;
    np:hasPublicationInfo ex:nanopub_1_pubinfo .

ex:nanopub_1_assertion {
    ex:paperA ex:hasResult ex:result1 .

    ex:paperA cito:cites "arXiv:1409.0473" .
    ex:paperA cito:cites "arXiv:1609.08144" .
    ex:paperA cito:cites "arXiv:1512.08756" .
    ex:paperA cito:cites "arXiv:1607.06450" .
    ex:paperA cito:cites "arXiv:1703.03130" .
    ex:paperA cito:cites "arXiv:1409.3215" .
    ex:paperA cito:cites "arXiv:1611.04558" .
    ex:paperA cito:cites "arXiv:1609.08144" .
    ex:paperA cito:cites "arXiv:1706.03762" .

    ex:model1 ex:hasAccuracy "0.9474"^^xsd:float ;
              ex:hasPrecision "0.9474"^^xsd:float ;
              ex:hasRecall "0.9474"^^xsd:float ;
              ex:hasF1Score "0.9474"^^xsd:float ;
              ex:evaluatedOn ex:testdata1 .
}

ex:nanopub_1_provenance {
    ex:model1 prov:wasGeneratedBy ex:evaluation1 .
    ex:evaluation1 prov:used ex:testdata1 .
    ex:model1 a ex:Model ;
        dct:identifier "model_attention.h5" .
    ex:testdata1 a ex:Dataset ;
        dct:identifier "test_dataset.csv" .
}

ex:nanopub_1_pubinfo {
    ex:paperA dct:creator "Ashish Vaswani" .
    ex:nanopub_1 dct:created "2024-04-21"^^xsd:date .
    ex:nanopub_1 pav:authoredBy <https://orcid.org/0000-0001-2345-6789> .
}
