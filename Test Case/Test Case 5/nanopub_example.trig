@prefix np: <http://www.nanopub.org/nschema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix ex: <http://example.org/> .
@prefix cito: <http://purl.org/spar/cito/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix pav: <http://purl.org/pav/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .

# Nanopublication Head
ex:nanopub_1 a np:Nanopublication ;
    np:hasAssertion ex:nanopub_1_assertion ;
    np:hasProvenance ex:nanopub_1_provenance ;
    np:hasPublicationInfo ex:nanopub_1_pubinfo .

# Assertion Graph
ex:nanopub_1_assertion {
    ex:paperA ex:hasResult ex:result1 .

    # ✅ Citations in literal form (for fraud detection)
    ex:paperA cito:cites "DOI:10.1007/s12652-018-0972-3" .
    ex:paperA cito:cites "DOI:10.1007/s10586-017-0879-3" .
    ex:paperA cito:cites "DOI:10.1007/s11277-016-3923-3" .
    ex:paperA cito:cites "DOI:10.1007/s10586-016-0672-8" .
    ex:paperA cito:cites "DOI:10.1007/s12652-016-0411-2" .
    ex:paperA cito:cites "DOI:10.1007/s10586-016-0549-x" .
    ex:paperA cito:cites "DOI:10.1007/s10799-015-0218-4" .
    ex:paperA cito:cites "DOI:10.1007/s11277-015-3069-8" .
    ex:paperA cito:cites "DOI:10.1007/s10799-015-0241-5" .
    ex:paperA cito:cites "arXiv:2301.04856" .

    # ✅ Metric values directly attached to model1 for validation
    ex:model1 ex:hasAccuracy "0.7532"^^xsd:float ;
              ex:hasPrecision "0.7554"^^xsd:float ;
              ex:hasRecall "0.7532"^^xsd:float ;
              ex:hasF1Score "0.7542"^^xsd:float ;
              ex:evaluatedOn ex:testdata1 .
}

# Provenance graph
ex:nanopub_1_provenance {
    ex:model1 prov:wasGeneratedBy ex:evaluation1 .
    ex:evaluation1 prov:used ex:testdata1 .
    ex:model1 a ex:Model ;
        dct:identifier "model_v1.h5" .
    ex:testdata1 a ex:Dataset ;
        dct:identifier "test_dataset.csv" .
}

# Publication Info graph
ex:nanopub_1_pubinfo {
    ex:paperA dct:creator "Sakshi Pandey" .
    ex:nanopub_1 dct:created "2024-04-20"^^xsd:date .
    ex:nanopub_1 pav:authoredBy <https://orcid.org/0000-0002-1825-0097> .
}
