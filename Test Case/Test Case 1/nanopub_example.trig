@prefix np: <http://www.nanopub.org/nschema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix ex: <http://example.org/> .
@prefix cito: <http://purl.org/spar/cito/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix pav: <http://purl.org/pav/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .

ex:nanopub_2 a np:Nanopublication ;
    np:hasAssertion ex:nanopub_2_assertion ;
    np:hasProvenance ex:nanopub_2_provenance ;
    np:hasPublicationInfo ex:nanopub_2_pubinfo .

ex:nanopub_2_assertion {
    ex:paperA ex:hasResult ex:result1 .

    ex:paperA cito:cites "DOI:10.1145/1182635.1164174" .
    ex:paperA cito:cites "DOI:10.1109/TKDE.2006.157" .
    ex:paperA cito:cites "DOI:10.1145/1322432.1322456" .
    ex:paperA cito:cites "DOI:10.1109/TKDE.2012.35" .
    ex:paperA cito:cites "DOI:10.1109/TKDE.2020.3020810" .
    ex:paperA cito:cites "DOI:10.1109/TKDE.2018.2810896" .
    ex:paperA cito:cites "DOI:10.1109/ICDE.2003.1260807" .

    ex:model1 ex:hasAccuracy "0.924"^^xsd:float ;
              ex:hasPrecision "0.921"^^xsd:float ;
              ex:hasRecall "0.925"^^xsd:float ;
              ex:hasF1Score "0.923"^^xsd:float ;
              ex:evaluatedOn ex:testdata1 .
}

ex:nanopub_2_provenance {
    ex:model1 prov:wasGeneratedBy ex:evaluation1 .
    ex:evaluation1 prov:used ex:testdata1 .
    ex:model1 a ex:Model ;
        dct:identifier "model_skyline.h5" .
    ex:testdata1 a ex:Dataset ;
        dct:identifier "test_dataset.csv" .
}

ex:nanopub_2_pubinfo {
    ex:paperA dct:creator "Yuanyuan Zhang" .
    ex:nanopub_2 dct:created "2024-04-21"^^xsd:date .
    ex:nanopub_2 pav:authoredBy <https://orcid.org/0000-0002-3456-7890> .
}
