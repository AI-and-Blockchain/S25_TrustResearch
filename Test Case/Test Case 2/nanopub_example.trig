@prefix np: <http://www.nanopub.org/nschema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix ex: <http://example.org/> .
@prefix cito: <http://purl.org/spar/cito/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix pav: <http://purl.org/pav/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .

ex:nanopub_3 a np:Nanopublication ;
    np:hasAssertion ex:nanopub_3_assertion ;
    np:hasProvenance ex:nanopub_3_provenance ;
    np:hasPublicationInfo ex:nanopub_3_pubinfo .

ex:nanopub_3_assertion {
    ex:paperA ex:hasResult ex:result1 .

    ex:paperA cito:cites "DOI:10.1016/j.ijpe.2021.108310" .
    ex:paperA cito:cites "DOI:10.1016/j.future.2021.01.038" .
    ex:paperA cito:cites "DOI:10.1016/j.cie.2019.106848" .
    ex:paperA cito:cites "DOI:10.1016/j.techfore.2020.120434" .
    ex:paperA cito:cites "DOI:10.1109/ACCESS.2019.2910481" .
    ex:paperA cito:cites "DOI:10.1109/ACCESS.2020.2980161" .
    ex:paperA cito:cites "arXiv:2103.03869" .

    ex:model1 ex:hasAccuracy "1.0000"^^xsd:float ;
              ex:hasPrecision "1.0000"^^xsd:float ;
              ex:hasRecall "1.0000"^^xsd:float ;
              ex:hasF1Score "1.0000"^^xsd:float ;
              ex:evaluatedOn ex:testdata1 .
}

ex:nanopub_3_provenance {
    ex:model1 prov:wasGeneratedBy ex:evaluation1 .
    ex:evaluation1 prov:used ex:testdata1 .
    ex:model1 a ex:Model ;
        dct:identifier "model_blockchain.h5" .
    ex:testdata1 a ex:Dataset ;
        dct:identifier "test_dataset.csv" .
}

ex:nanopub_3_pubinfo {
    ex:paperA dct:creator "Halida Achmad Bagraff" .
    ex:nanopub_3 dct:created "2024-04-21"^^xsd:date .
    ex:nanopub_3 pav:authoredBy <https://orcid.org/0000-0003-4567-8910> .
}
